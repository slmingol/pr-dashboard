# GitHub Personal Access Token (required)
# Get your token: gh auth token
# Or create one at: https://github.com/settings/tokens
GH_TOKEN=your_github_token_here

# Same token — required by ghreport and ghreportToken variants
GITHUB_TOKEN=your_github_token_here
ghreportToken=your_github_token_here

# Server config
PORT=3000
NODE_ENV=development

# Path to ghreport config.yaml (default: ~/.config/ghreport/config.yaml)
# GHREPORT_CONFIG=/root/.config/ghreport/config.yaml

# Path to write ghreport-format output file (default: unset)
# GHREPORT_OUTPUT=/data/ghreport.txt

# Overrides package.json version in logs/API (set automatically by make up/build)
# APP_VERSION=1.1.0-193.abc1234

# Paths for persistent cache files (defaults shown)
# PR_LIST_CACHE_FILE=/data/pr-list-cache.json
# REVIEW_CACHE_FILE=/data/review-cache.json
# BACKOFF_FILE=/data/gh-backoff.json
